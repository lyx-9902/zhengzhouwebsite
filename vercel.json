{
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "/img/**",
      "use": "@vercel/static"
    },
    {
      "src": "/js/**",
      "use": "@vercel/static"
    },
    {
      "src": "/lib/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}